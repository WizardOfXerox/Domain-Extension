{
  "manifest_version": 3,
  "name": "Fake TLD Loader",
  "version": "3.0",
  "description": "Local-first hosting for real + fake domains with instant routing via Chrome proxy (PAC) + local TLS.",
  "permissions": ["tabs", "storage", "proxy", "browsingData"],
  "host_permissions": ["http://127.0.0.1:9080/*"],
  "background": {
    "service_worker": "sw.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Domain Mode",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "64": "icons/64x64.png",
      "128": "icons/128x128.png",
      "256": "icons/256x256.png",
      "512": "icons/512x512.png",
      "1024": "icons/1024x1024.png"
    }
  }
}
